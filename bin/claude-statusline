#!/usr/bin/env bash

# Colors
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
MAGENTA='\033[0;35m'
DIM='\033[2m'
RESET='\033[0m'

# Separator (minimal style)
SEP="${DIM}│${RESET}"

# Emoji icons
ICON_PROJECT="📁"
ICON_BRANCH="🌿"

# Read JSON input from stdin
input=$(cat)

# Helper functions
get_model_name() { echo "$input" | jq -r '.model.display_name // "Unknown Model"'; }

get_model_icon() {
  local model_name
  model_name=$(get_model_name)
  case "$model_name" in
    *[Oo]pus*)   echo "🎭" ;;
    *[Ss]onnet*) echo "🎵" ;;
    *[Hh]aiku*)  echo "🍃" ;;
    *)           echo "🧠" ;;
  esac
}

get_current_dir() { echo "$input" | jq -r '.workspace.current_dir // "."'; }
get_project_dir() { echo "$input" | jq -r '.workspace.project_dir // "."'; }

# Token display using pre-calculated used_percentage (resets on /compact and /clear).
# Falls back to raw token math only when no messages have been sent yet (null).
get_token_display() {
  local pct
  pct=$(echo "$input" | jq -r '.context_window.used_percentage // empty')

  if [ -z "$pct" ]; then
    # No messages yet — nothing to show
    printf "${DIM}ctx: --${RESET}"
    return
  fi

  local pct_int
  pct_int=$(printf '%.0f' "$pct")

  # Also show raw token count for reference
  local tokens
  tokens=$(echo "$input" | jq -r '
    (.context_window.current_usage // {}) as $u
    | (($u.input_tokens // 0)
      + ($u.cache_creation_input_tokens // 0)
      + ($u.cache_read_input_tokens // 0))')
  local k=$(( tokens / 1000 ))

  local color
  if   (( pct_int > 85 )); then color="$RED"
  elif (( pct_int >= 60 )); then color="$YELLOW"
  else                           color="$GREEN"
  fi
  printf "${color}%dK %d%%${RESET}" "$k" "$pct_int"
}

# Extract values
model=$(get_model_name)
model_icon=$(get_model_icon)
current_dir=$(get_current_dir)
project_dir=$(get_project_dir)
token_display=$(get_token_display)

# Get project name and handle subdirectory display
project=$(basename "$project_dir")
if [ "$current_dir" != "$project_dir" ]; then
  subdir=$(basename "$current_dir")
  project="${project} (CWD: ${subdir}/)"
fi

# Get git branch (skip optional locks)
git_branch=$(GIT_OPTIONAL_LOCKS=0 git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "no-git")

# Build statusline (order: foldername → branchname → model → tokens)
statusline=""
statusline+="${ICON_PROJECT} ${BLUE}${project}${RESET}"
statusline+=" ${SEP} "
statusline+="${ICON_BRANCH} ${GREEN}${git_branch}${RESET}"
statusline+=" ${SEP} "
statusline+="${model_icon} ${MAGENTA}${model}${RESET}"
statusline+=" ${SEP} "
statusline+="${token_display}"

echo -e "$statusline"
