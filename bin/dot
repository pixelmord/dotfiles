#!/usr/bin/env bash

set -Eeuo pipefail
trap cleanup SIGINT SIGTERM ERR EXIT

cleanup() {
  trap - SIGINT SIGTERM ERR EXIT
  tput cnorm # enable cursor
  # script cleanup here
}

command_name=$(basename "${BASH_SOURCE[0]}")
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd -P)
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

if [[ -f "$DOTFILES/bin/lib/common.sh" ]]; then
  source "$DOTFILES/bin/lib/common.sh"
else
  echo "Error: Unable to source common.sh"
  exit 1
fi

find_commands() {
  IFS=: read -ra path_dirs <<<"$PATH"
  for dir in "${path_dirs[@]}"; do
    # skip if the directory doesn't exist or isn't readable
    [[ ! -d "$dir" ]] && continue
    for cmd in "$dir"/dot-*; do
      [[ -f "$cmd" && -x "$cmd" ]] || continue
      basename "$cmd" | sed 's/^dot-//'
    done
  done | sort -u
}

usage() {
  cat <<EOF
  $(fmt_key "Usage:") $(fmt_cmd "$command_name") $(fmt_value "<command> [subcommand] [options]")

Dotfiles management script.

$(fmt_key "Available Commands:")
    help                          Show this help message
    clean                         Clean up broken symlinks
    backup                        Backup dotfiles and system state
        full                      Full backup (all options below)
        config                    Backup config files only (default)
        packages                  Export brew/npm/pnpm package lists
        repos                     Export git repos from workspace
        secrets                   Backup secrets (.ssh, .gnupg, .aws, etc.)
        apps                      Backup app settings (Raycast, Cursor)
        -d, --directory <dir>     Backup directory (default: ~/dotfiles-backup)
        -v, --verbose             Show detailed output
    link                          Link dotfiles packages to their respective locations
        all                       Link all
        <pkg>                     Link a specific package
        clean                     Clean up broken symlinks
            -n, --dry-run         Show what would be removed without actually removing
            -v, --verbose         Show detailed output
        -v, --verbose             Show detailed output
    unlink                        Unlink dotfiles packages
        all                       Unlink all
        <pkg>                     Unlink a specific package
        -v, --verbose             Show detailed output
EOF

  echo -e "\nExternal commands:"

  find_commands | while read -r cmd; do
    # Get the description from the script if available
    description=$(grep "^# Description:" "$(which "dot-$cmd")" 2>/dev/null | cut -d: -f2- | sed 's/^[[:space:]]*//' || echo "No description available")
    printf "    $(fmt_cmd "%-12s") %s\n" "$cmd" "$description"
  done
}

cmd_clean() {
  links=(
    ".zshrc" ".zshenv" ".zprofile" ".zsh_aliases"
    ".zsh_functions" ".zsh_prompt" ".config/aerospace"
    ".config/git" ".config/karabiner" ".config/kitty"
    ".config/lazygit" ".config/nvim" ".config/ripgrep"
    ".config/tmux" ".config/wezterm" ".config/zsh"
  )

  fmt_title_underline "Cleaning up broken legacy symlinks..."

  for link in "${links[@]}"; do
    path_link="$HOME/$link"
    if [ -L "$path_link" ] && [ ! -e "$path_link" ]; then
      log_success "Removing Broken symbolic link: $path_link"
      rm "$path_link"
    else
      log_info "Link to $path_link not found or is not broken. Skipping..."
    fi
  done

  # Clean up broken symlinks from home directory
  if [ -d "$DOTFILES/home" ]; then
    while IFS= read -r -d '' file; do
      relative_path="${file#"$DOTFILES"/home/}"
      target_path="$HOME/$relative_path"
      if [ -L "$target_path" ] && [ ! -e "$target_path" ]; then
        log_success "Removing broken symbolic link: $target_path"
        rm "$target_path"
      fi
    done < <(find "$DOTFILES/home" -type f -print0)
  fi

  echo -e
  log_success "Done."
}

cmd_backup() {
  local backup_dir="$HOME/dotfiles-backup"
  local verbose=false
  local subcmd="config"
  local args=()

  # Parse arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -d | --directory)
      if [[ -n "${2:-}" ]]; then
        backup_dir="$2"
        shift 2
      else
        log_error "Missing backup directory"
        exit 1
      fi
      ;;
    -v | --verbose)
      verbose=true
      shift
      ;;
    full | config | packages | repos | secrets | apps)
      subcmd="$1"
      shift
      ;;
    *)
      log_error "Unknown argument: $1"
      exit 1
      ;;
    esac
  done

  # Expand ~ in backup_dir
  backup_dir="${backup_dir/#\~/$HOME}"
  local timestamp=$(date +%Y%m%d_%H%M%S)
  local backup_path="${backup_dir}/backup_${timestamp}"

  # Create backup directory
  mkdir -p "$backup_path"

  case "$subcmd" in
  full)
    backup_packages "$backup_path" "$verbose"
    backup_repos "$backup_path" "$verbose"
    backup_secrets "$backup_path" "$verbose"
    backup_apps "$backup_path" "$verbose"
    backup_config "$backup_path" "$verbose"
    ;;
  config)
    backup_config "$backup_path" "$verbose"
    ;;
  packages)
    backup_packages "$backup_path" "$verbose"
    ;;
  repos)
    backup_repos "$backup_path" "$verbose"
    ;;
  secrets)
    backup_secrets "$backup_path" "$verbose"
    ;;
  apps)
    backup_apps "$backup_path" "$verbose"
    ;;
  esac

  echo
  log_success "Backup completed: $backup_path"
  ls -lh "$backup_path"
}

backup_packages() {
  local backup_path="$1"
  local verbose="$2"

  fmt_title_underline "Exporting package lists"

  # Homebrew
  if command -v brew &>/dev/null; then
    log_info "Exporting Homebrew packages..."
    brew leaves > "$backup_path/brew-leaves.txt"
    brew list --cask > "$backup_path/brew-casks.txt" 2>/dev/null || true
    [[ "$verbose" == true ]] && log_info "  $(wc -l < "$backup_path/brew-leaves.txt") formulae, $(wc -l < "$backup_path/brew-casks.txt") casks"
  fi

  # npm global packages
  if command -v npm &>/dev/null; then
    log_info "Exporting npm global packages..."
    npm list -g --depth=0 --json 2>/dev/null | jq -r '.dependencies | keys[]' > "$backup_path/npm-global.txt" 2>/dev/null || true
    [[ "$verbose" == true ]] && [[ -f "$backup_path/npm-global.txt" ]] && log_info "  $(wc -l < "$backup_path/npm-global.txt") packages"
  fi

  # pnpm global packages
  if command -v pnpm &>/dev/null; then
    log_info "Exporting pnpm global packages..."
    pnpm list -g --depth=0 2>/dev/null | tail -n +2 > "$backup_path/pnpm-global.txt" || true
    [[ "$verbose" == true ]] && [[ -f "$backup_path/pnpm-global.txt" ]] && log_info "  $(wc -l < "$backup_path/pnpm-global.txt") packages"
  fi

  # Python packages (if using uv or pip)
  if command -v uv &>/dev/null; then
    log_info "Exporting uv tools..."
    uv tool list 2>/dev/null > "$backup_path/uv-tools.txt" || true
  elif command -v pip &>/dev/null; then
    log_info "Exporting pip packages..."
    pip list --user --format=freeze 2>/dev/null > "$backup_path/pip-user.txt" || true
  fi

  log_success "Package lists exported"
}

backup_repos() {
  local backup_path="$1"
  local verbose="$2"
  local workspace="${CODE_DIR:-$HOME/workspace}"

  fmt_title_underline "Exporting git repositories"

  if [[ ! -d "$workspace" ]]; then
    log_warning "Workspace directory not found: $workspace"
    return
  fi

  log_info "Scanning $workspace for git repos..."

  local repo_file="$backup_path/git-repos.txt"
  local count=0

  : > "$repo_file"  # truncate file

  while IFS= read -r -d '' git_dir; do
    local repo_dir=$(dirname "$git_dir")
    local repo_name=$(basename "$repo_dir")
    local remote_url=$(git -C "$repo_dir" remote get-url origin 2>/dev/null || echo "no remote")

    echo "$repo_name|$remote_url" >> "$repo_file"
    [[ "$verbose" == true ]] && log_info "  $repo_name: $remote_url"
    ((count++))
  done < <(find "$workspace" -maxdepth 3 -name ".git" -type d -print0 2>/dev/null)

  log_success "Found $count repositories"
}

backup_secrets() {
  local backup_path="$1"
  local verbose="$2"
  local secrets_dir="$backup_path/secrets"

  fmt_title_underline "Backing up secrets and credentials"

  mkdir -p "$secrets_dir"

  # Files to backup (only if they exist and are not symlinks)
  local secret_files=(
    ".ssh"
    ".gnupg"
    ".aws"
    ".gitconfig.local"
    ".npmrc"
    ".netrc"
    ".zshrc.local"
    ".zshenv.local"
    ".config/gh"
  )

  for file in "${secret_files[@]}"; do
    local src="$HOME/$file"
    if [[ -e "$src" && ! -L "$src" ]]; then
      log_info "Backing up ~/$file"
      cp -Rp "$src" "$secrets_dir/" 2>/dev/null || log_warning "Failed to copy $file"
      [[ "$verbose" == true ]] && log_info "  Copied $file"
    else
      [[ "$verbose" == true ]] && log_info "  Skipping $file (not found or symlink)"
    fi
  done

  # Backup zsh history
  if [[ -f "$HOME/.zsh_history" ]]; then
    log_info "Backing up zsh history"
    cp -p "$HOME/.zsh_history" "$secrets_dir/"
  fi

  log_success "Secrets backed up"
  log_warning "Remember: secrets directory contains sensitive data!"
}

backup_apps() {
  local backup_path="$1"
  local verbose="$2"
  local apps_dir="$backup_path/apps"

  fmt_title_underline "Backing up application settings"

  mkdir -p "$apps_dir"

  # Raycast
  local raycast_dir="$HOME/Library/Application Support/Raycast"
  if [[ -d "$raycast_dir" ]]; then
    log_info "Backing up Raycast settings..."
    mkdir -p "$apps_dir/Raycast"
    # Only backup config, not cache
    cp -Rp "$raycast_dir/Preferences" "$apps_dir/Raycast/" 2>/dev/null || true
    cp -Rp "$raycast_dir/Extensions" "$apps_dir/Raycast/" 2>/dev/null || true
  fi

  # Cursor
  local cursor_dir="$HOME/Library/Application Support/Cursor/User"
  if [[ -d "$cursor_dir" ]]; then
    log_info "Backing up Cursor settings..."
    mkdir -p "$apps_dir/Cursor"
    cp -p "$cursor_dir/settings.json" "$apps_dir/Cursor/" 2>/dev/null || true
    cp -p "$cursor_dir/keybindings.json" "$apps_dir/Cursor/" 2>/dev/null || true
    [[ -d "$cursor_dir/snippets" ]] && cp -Rp "$cursor_dir/snippets" "$apps_dir/Cursor/" 2>/dev/null || true
    # Export extensions list
    if command -v cursor &>/dev/null; then
      cursor --list-extensions > "$apps_dir/Cursor/extensions.txt" 2>/dev/null || true
    fi
  fi

  # Bartender
  local bartender_plist="$HOME/Library/Preferences/com.surteesstudios.Bartender.plist"
  if [[ -f "$bartender_plist" ]]; then
    log_info "Backing up Bartender settings..."
    cp -p "$bartender_plist" "$apps_dir/" 2>/dev/null || true
  fi

  # Karabiner (if exists and not symlinked)
  local karabiner_dir="$HOME/.config/karabiner"
  if [[ -d "$karabiner_dir" && ! -L "$karabiner_dir" ]]; then
    log_info "Backing up Karabiner settings..."
    cp -Rp "$karabiner_dir" "$apps_dir/" 2>/dev/null || true
  fi

  log_success "Application settings backed up"
}

backup_config() {
  local backup_path="$1"
  local verbose="$2"

  fmt_title_underline "Backing up config files"

  local config_files=(
    ".zshrc"
    ".zprofile"
    ".zsh_aliases"
    ".zsh_functions"
    ".zsh_prompt"
    ".config/aerospace"
    ".config/git"
    ".config/ghostty"
    ".config/karabiner"
    ".config/kitty"
    ".config/lazygit"
    ".config/nvim"
    ".config/ripgrep"
    ".config/starship"
    ".config/tmux"
    ".config/wezterm"
    ".config/zsh"
  )

  # Add home directory files from dotfiles
  if [[ -d "$DOTFILES/home" ]]; then
    while IFS= read -r -d '' file; do
      local relative_path="${file#"$DOTFILES"/home/}"
      config_files+=("$relative_path")
    done < <(find "$DOTFILES/home" -type f -print0)
  fi

  local tmpfile=$(mktemp)
  trap 'rm -f "$tmpfile"' RETURN

  for file in "${config_files[@]}"; do
    local src_path="${HOME}/${file}"
    if [[ -L "$src_path" ]]; then
      [[ "$verbose" == true ]] && log_info "Skipping symlink: $file"
      continue
    elif [[ -e "$src_path" ]]; then
      echo "$file" >> "$tmpfile"
      [[ "$verbose" == true ]] && log_info "Found: $file"
    fi
  done

  if [[ -s "$tmpfile" ]]; then
    log_info "Creating config archive..."
    tar -czf "${backup_path}/config.tar.gz" -C "$HOME" -T "$tmpfile" || {
      log_error "Failed to create config archive"
      return 1
    }
    log_success "Config files archived"
  else
    log_warning "No config files to backup (all are symlinks - good!)"
  fi
}

link_home_files() {
  local operation="$1"
  local verbose="$2"

  if [ ! -d "$DOTFILES/home" ]; then
    return 0
  fi

  while IFS= read -r -d '' file; do
    local relative_path="${file#"$DOTFILES"/home/}"
    local target_path="$HOME/$relative_path"
    local target_dir="$(dirname "$target_path")"

    if [ "$operation" = "link" ]; then
      # Create parent directories if needed
      if [ ! -d "$target_dir" ]; then
        [ "$verbose" = true ] && log_info "Creating directory: $target_dir"
        mkdir -p "$target_dir"
      fi

      if [ -e "$target_path" ]; then
        log_warning "~${target_path#"$HOME"} already exists... Skipping."
      else
        [ "$verbose" = true ] && log_info "Linking $relative_path"
        ln -s "$file" "$target_path"
      fi
    else # unlink
      if [ -L "$target_path" ]; then
        [ "$verbose" = true ] && log_info "Unlinking $target_path"
        rm "$target_path"
      elif [ -e "$target_path" ]; then
        log_warning "Skipping \"$target_path\" because it is not a symlink"
      fi
    fi
  done < <(find "$DOTFILES/home" -type f -print0)
}

cmd_link_clean() {
  local verbose=false
  local dry_run=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -v | --verbose)
      verbose=true
      shift
      ;;
    -n | --dry-run)
      dry_run=true
      shift
      ;;
    *)
      log_error "Unknown argument: $1"
      exit 1
      ;;
    esac
  done

  fmt_title_underline "Cleaning up broken symlinks"

  local broken_count=0

  # Check config directory symlinks
  if [ -d "$CONFIG_HOME" ]; then
    while IFS= read -r -d '' link; do
      if [ -L "$link" ] && [ ! -e "$link" ]; then
        broken_count=$((broken_count + 1))
        if [ "$dry_run" = true ]; then
          log_warning "[DRY RUN] Would remove broken symlink: ~${link#"$HOME"}"
        else
          [ "$verbose" = true ] && log_info "Removing broken symlink: ~${link#"$HOME"}"
          rm "$link"
        fi
      fi
    done < <(find "$CONFIG_HOME" -type l -print0 2>/dev/null || true)
  fi

  # Check home directory symlinks created from $DOTFILES/home
  if [ -d "$DOTFILES/home" ]; then
    # Get all directories that contain files in $DOTFILES/home
    local home_dirs=()
    while IFS= read -r -d '' file; do
      local dir_path="$HOME/$(dirname "${file#"$DOTFILES"/home/}")"
      # Add to array if not already present
      if [[ ! " ${home_dirs[@]} " =~ " ${dir_path} " ]]; then
        home_dirs+=("$dir_path")
      fi
    done < <(find "$DOTFILES/home" -type f -print0)

    # Now check for broken symlinks only in those directories
    for dir in "${home_dirs[@]}"; do
      if [ -d "$dir" ]; then
        while IFS= read -r -d '' link; do
          if [ -L "$link" ] && [ ! -e "$link" ]; then
            # Check if this broken symlink points to our dotfiles directory
            local link_target=$(readlink "$link")
            if [[ "$link_target" == "$DOTFILES"* ]]; then
              broken_count=$((broken_count + 1))
              if [ "$dry_run" = true ]; then
                log_warning "[DRY RUN] Would remove broken symlink: ~${link#"$HOME"}"
              else
                [ "$verbose" = true ] && log_info "Removing broken symlink: ~${link#"$HOME"}"
                rm "$link"
              fi
            fi
          fi
        done < <(find "$dir" -maxdepth 1 -type l -print0 2>/dev/null || true)
      fi
    done
  fi

  echo
  if [ "$broken_count" -eq 0 ]; then
    log_success "No broken symlinks found"
  else
    if [ "$dry_run" = true ]; then
      log_info "Found $broken_count broken symlink(s). Run without --dry-run to remove them."
    else
      log_success "Removed $broken_count broken symlink(s)"
    fi
  fi
}

cmd_link() {
  local operation="$1"
  local pkg="$2"
  shift 2 || true

  # Handle 'dot link clean' syntax
  if [ "$operation" = "link" ] && [ "$pkg" = "clean" ]; then
    cmd_link_clean "$@"
    return
  fi

  local verbose=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -v | --verbose)
      verbose=true
      shift
      ;;
    *)
      log_error "Unknown argument: $1"
      exit 1
      ;;
    esac
  done

  if [ "$pkg" = "all" ]; then
    local title_text="$operation"ing" all packages"
  else
    local title_text="$operation"ing" package: $pkg"
  fi

  fmt_title_underline "$title_text"

  if [ "$pkg" = "all" ]; then
    # Handle all packages in config directory
    for config in "$DOTFILES/config"/*; do
      if [ -d "$config" ]; then
        local target="$CONFIG_HOME/$(basename "$config")"
        if [ "$operation" = "link" ]; then
          if [ -e "$target" ]; then
            log_warning "~${target#"$HOME"} already exists... Skipping."
          else
            [ "$verbose" = true ] && log_info "Linking $(basename "$config")"
            ln -s "$config" "$target"
          fi
        else # unlink
          if [ -L "$target" ]; then
            [ "$verbose" = true ] && log_info "Unlinking $target"
            rm "$target"
          elif [ -e "$target" ]; then
            log_warning "Skipping \"$target\" because it is not a symlink"
          fi
        fi
      fi
    done

    # Handle home directory files
    link_home_files "$operation" "$verbose"
  else
    # Handle specific package
    local target="$CONFIG_HOME/$pkg"
    if [ -d "$DOTFILES/config/$pkg" ]; then
      if [ "$operation" = "link" ]; then
        if [ -e "$target" ]; then
          log_warning "~${target#"$HOME"} already exists... Skipping."
        else
          [ "$verbose" = true ] && log_info "Linking $pkg"
          ln -s "$DOTFILES/config/$pkg" "$target"
        fi
      else # unlink
        if [ -L "$target" ]; then
          [ "$verbose" = true ] && log_info "Unlinking $target"
          rm "$target"
        elif [ -e "$target" ]; then
          log_warning "Skipping \"$target\" because it is not a symlink"
        fi
      fi
    else
      log_error "Package $pkg not found in config directory"
      return 1
    fi
  fi

  echo -e
  log_success "Done"
}

main() {
  if [ $# -lt 1 ]; then
    usage
    exit 0
  fi

  cmd="$1"
  shift || true
  subcmd="${1:-all}"

  case "$cmd" in
  help)
    usage
    ;;
  clean)
    cmd_clean "$@"
    ;;
  backup)
    cmd_backup "$@"
    ;;
  link)
    cmd_link "link" "$@"
    ;;
  unlink)
    cmd_link "unlink" "$@"
    ;;
  *)
    if command -v "dot-$cmd" >/dev/null 2>&1; then
      "dot-$cmd" "$@"
    else
      log_error "Unknown command: $cmd"
      usage
      exit 1
    fi
    ;;
  esac
}

main "$@"
