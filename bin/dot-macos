#!/usr/bin/env bash
# Description: Configure macOS system settings

set -Eeuo pipefail

# source helpers
source "$DOTFILES/bin/lib/common.sh"
command_name=$(basename "${BASH_SOURCE[0]}")

usage() {
  cat <<EOF
  $(fmt_key "Usage:") $(fmt_key "$command_name") $(fmt_value "[options] <command>")

Options:
    -h, --help       Show this help message
    defaults         Setup macOS defaults
EOF
}

setup_macos() {
  fmt_title_underline "Configuring macOS"

  if [[ "$(uname)" != "Darwin" ]]; then
    log_error "Cannot run this command on non-macOS system. Exiting."
    exit 1
  fi

  # Close System Preferences to prevent it from overriding settings
  osascript -e 'tell application "System Preferences" to quit' 2>/dev/null || true

  ###############################################################################
  # General UI/UX
  ###############################################################################

  log_info "Expand save panel by default"
  defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode -bool true
  defaults write NSGlobalDomain NSNavPanelExpandedStateForSaveMode2 -bool true

  log_info "Expand print panel by default"
  defaults write NSGlobalDomain PMPrintingExpandedStateForPrint -bool true
  defaults write NSGlobalDomain PMPrintingExpandedStateForPrint2 -bool true

  log_info "Save to disk (not to iCloud) by default"
  defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false

  log_info "Disable the 'Are you sure you want to open this application?' dialog"
  defaults write com.apple.LaunchServices LSQuarantine -bool false

  ###############################################################################
  # Text input - important for coding
  ###############################################################################

  log_info "Disable automatic capitalization"
  defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool false

  log_info "Disable smart dashes"
  defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false

  log_info "Disable automatic period substitution"
  defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool false

  log_info "Disable smart quotes"
  defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false

  log_info "Disable auto-correct"
  defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false

  ###############################################################################
  # Keyboard
  ###############################################################################

  log_info "Enable full keyboard access for all controls (Tab in modal dialogs)"
  defaults write NSGlobalDomain AppleKeyboardUIMode -int 3

  log_info "Disable press-and-hold for keys in favor of key repeat"
  defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false

  log_info "Set fast keyboard repeat rate"
  defaults write NSGlobalDomain KeyRepeat -int 2

  log_info "Set short delay until key repeat"
  defaults write NSGlobalDomain InitialKeyRepeat -int 15

  ###############################################################################
  # Trackpad
  ###############################################################################

  log_info "Enable tap to click"
  defaults write com.apple.driver.AppleBluetoothMultitouch.trackpad Clicking -bool true
  defaults -currentHost write NSGlobalDomain com.apple.mouse.tapBehavior -int 1
  defaults write NSGlobalDomain com.apple.mouse.tapBehavior -int 1

  ###############################################################################
  # Screen
  ###############################################################################

  log_info "Require password immediately after sleep or screen saver"
  defaults write com.apple.screensaver askForPassword -int 1
  defaults write com.apple.screensaver askForPasswordDelay -int 0

  log_info "Save screenshots to Desktop"
  defaults write com.apple.screencapture location -string "${HOME}/Desktop"

  log_info "Save screenshots in PNG format"
  defaults write com.apple.screencapture type -string "png"

  log_info "Disable shadow in screenshots"
  defaults write com.apple.screencapture disable-shadow -bool true

  log_info "Enable subpixel font rendering on non-Apple LCDs"
  defaults write NSGlobalDomain AppleFontSmoothing -int 1

  ###############################################################################
  # Finder
  ###############################################################################

  log_info "Show all filename extensions"
  defaults write NSGlobalDomain AppleShowAllExtensions -bool true

  log_info "Show hidden files"
  defaults write com.apple.finder AppleShowAllFiles -bool true

  log_info "Show status bar"
  defaults write com.apple.finder ShowStatusBar -bool true

  log_info "Show path bar"
  defaults write com.apple.finder ShowPathbar -bool true

  log_info "Display full POSIX path as window title"
  defaults write com.apple.finder _FXShowPosixPathInTitle -bool true

  log_info "Keep folders on top when sorting by name"
  defaults write com.apple.finder _FXSortFoldersFirst -bool true

  log_info "Search current folder by default"
  defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"

  log_info "Disable warning when changing file extension"
  defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false

  log_info "Avoid creating .DS_Store files on network volumes"
  defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true

  log_info "Avoid creating .DS_Store files on USB volumes"
  defaults write com.apple.desktopservices DSDontWriteUSBStores -bool true

  log_info "Use list view in all Finder windows by default"
  defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"

  log_info "Show ~/Library folder"
  chflags nohidden ~/Library

  log_info "Show /Volumes folder"
  sudo chflags nohidden /Volumes

  ###############################################################################
  # Dock
  ###############################################################################

  log_info "Set Dock icon size to 48 pixels"
  defaults write com.apple.dock tilesize -int 48

  log_info "Minimize windows using scale effect"
  defaults write com.apple.dock mineffect -string "scale"

  log_info "Speed up Mission Control animations"
  defaults write com.apple.dock expose-animation-duration -float 0.1

  log_info "Don't automatically rearrange Spaces based on recent use"
  defaults write com.apple.dock mru-spaces -bool false

  log_info "Automatically hide and show the Dock"
  defaults write com.apple.dock autohide -bool true

  log_info "Remove auto-hiding Dock delay"
  defaults write com.apple.dock autohide-delay -float 0

  log_info "Speed up Dock hide/show animation"
  defaults write com.apple.dock autohide-time-modifier -float 0.3

  ###############################################################################
  # Window Management
  ###############################################################################

  log_info "Ctrl+Cmd drag to move windows from anywhere"
  defaults write -g NSWindowShouldDragOnGesture -bool true

  ###############################################################################
  # Terminal
  ###############################################################################

  log_info "Only use UTF-8 in Terminal.app"
  defaults write com.apple.terminal StringEncodings -array 4

  log_info "Enable Secure Keyboard Entry in Terminal.app"
  defaults write com.apple.terminal SecureKeyboardEntry -bool true

  ###############################################################################
  # Activity Monitor
  ###############################################################################

  log_info "Show all processes in Activity Monitor"
  defaults write com.apple.ActivityMonitor ShowCategory -int 0

  log_info "Visualize CPU usage in Activity Monitor Dock icon"
  defaults write com.apple.ActivityMonitor IconType -int 5

  ###############################################################################
  # Restart affected apps
  ###############################################################################

  log_info "Restarting affected applications..."
  for app in "Finder" "Dock" "SystemUIServer"; do
    killall "${app}" &>/dev/null || true
  done

  log_success "Done. Some changes require logout/restart to take effect."
}

main() {
  local subcmd=""

  if [ $# -lt 1 ]; then
    usage
    exit 0
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    *)
      subcmd="$1"
      shift
      ;;
    esac
  done

  case "$subcmd" in
  defaults)
    setup_macos
    ;;
  *)
    log_error "Unknown legacy command: $subcmd"
    echo -e
    usage
    exit 1
    ;;
  esac
}

main "$@"
