#!/usr/bin/env zsh
# Shell aliases - sourced by .zshrc

# Reload zsh configuration
alias reload!="RELOAD=1 source $XDG_CONFIG_HOME/zsh/.zshrc"

# Verbose file operations (safer)
alias mv='mv -v'
# Verbose copy
alias cp='cp -v'
# Use trash instead of rm (macOS: `trash`; Linux: trash-cli `trash-put` or `gio trash`)
case "$OSTYPE" in
  darwin*)
    command -v trash &>/dev/null && alias rm='trash'
    ;;
  *)
    if command -v trash-put &>/dev/null; then
      alias rm='trash-put'
    elif command -v gio &>/dev/null; then
      alias rm='gio trash'
    fi
    ;;
esac

# Go up one directory
alias ..='cd ..'
# Go up two directories
alias ...='cd ../..'
# Go up three directories
alias ....="cd ../../.."
# Go up four directories
alias .....="cd ../../../.."

# Colored grep output
alias grep='grep --color=auto'
# Human-readable disk free
alias df='df -h'
# Human-readable disk usage
alias du='du -h -c'
# List PATH entries (one per line)
alias lpath='echo $PATH | tr ":" "\n"'

# Open iOS Simulator
alias ios='open -a /Applications/Xcode.app/Contents/Developer/Applications/Simulator.app'

# Hide desktop icons (for presentations)
alias hidedesktop="defaults write com.apple.finder CreateDesktop -bool false && killall Finder"
# Show desktop icons
alias showdesktop="defaults write com.apple.finder CreateDesktop -bool true && killall Finder"

# Delete all .DS_Store files recursively
alias cleanup="find . -name '*.DS_Store' -type f -ls -delete"
# Remove broken symlinks
alias clsym="find -L . -name . -o -type d -prune -o -type l -exec rm {} +"

# Directory listing (uses eza if available)
if [[ -x "$(command -v eza)" ]]; then
  # Long listing with git status
  alias ll="eza --icons --git --long"
  # Long listing including hidden files
  alias l="eza --icons --git --all --long"
else
  alias l="ls -lah ${colorflag}"
  alias ll="ls -lFh ${colorflag}"
fi
# List all files
alias la="ls -AF ${colorflag}"
# List directories only
alias lld="ls -l | grep ^d"
# Force remove (bypass trash — use the real rm binary)
alias rmf="command rm -rf"

# Git status (short)
alias gs='git s'
# Git log (pretty)
alias glog="git l"

# Tmux attach to last session
alias ta='tmux attach'
# List tmux sessions
alias tls='tmux ls'
# Attach to named session
alias tat='tmux attach -t'
# New named session
alias tns='tmux new-session -s'

# Use neovim as vim
if [[ -n "$(command -v nvim)" ]]; then
    alias vim="nvim"
    # Update neovim plugins
    alias vimu="nvim --headless \"+Lazy! sync\" +qa"
    # Open neovim with git status
    alias vimg="nvim +Ge:"
fi

# Claude without permission prompts
alias claude!="claude --dangerously-skip-permissions"

# Clone repo and cd into it
clone() {
    git clone --depth=1 "$1"
    cd "$(basename "${1%.*}")" || return
}

# Get public IP address
alias ip="dig +short myip.opendns.com @resolver1.opendns.com"
# Get local IP address
alias localip="ipconfig getifaddr en0"
# Flush DNS cache
alias flush="dscacheutil -flushcache && sudo killall -HUP mDNSResponder"

# List npm global packages
alias nlg="npm list -g --depth=0 2>/dev/null"
# List npm local packages
alias nl="npm list --depth=0 2>/dev/null"

# List pnpm global packages
alias plg="pnpm list -g"
# List pnpm local packages
alias pl="pnpm list"

# Copy to clipboard (trim newlines)
alias clip="tr -d '\n' | pbcopy"